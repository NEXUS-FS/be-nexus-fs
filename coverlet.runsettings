<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <CoverletOutput>coverage/</CoverletOutput>
          <Exclude>
            [Infrastructure]Infrastructure.Migrations.*
            [Infrastructure]Infrastructure.Services.*
            [be-nexus-fs]Program,
            [be-nexus-fs]AutoGeneratedProgram,
            [*]*Program*,
            [*]*AutoGeneratedProgram*
          </Exclude>
          <ExcludeByFile>
            **/Infrastructure/Migrations/**/*.cs;
            **/Infrastructure/Services/**/*.cs;
            **/*Program*.cs;
            **/AutoGeneratedProgram*.cs
          </ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
